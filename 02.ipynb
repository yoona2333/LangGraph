    "left=[\"start\",\"node_1运行完毕\"] #`left`：当前已累计的状态值；  right：本次待合并的新值。\n",
    "\n",
    "right=[\"node_2运行完毕\",\"node_3运行完毕\"]\n",
    "print(my_reducer(left,right))\n"
